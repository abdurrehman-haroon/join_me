{
  "expo": {
    "name": "Join Me",
    "slug": "join-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abdrhsteam.joinme"
    },
    "android": {
      "package": "com.abdrhsteam.joinme"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Join Me uses your location to show places near you when you pick where to meet. It is never saved."
        }
      ]
    ],
    "scheme": "joinme"
  }
}
