{
  "expo": {
    "name": "Join Me",
    "slug": "campus-pickup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.abdrhsteam.campuspickup"
    },
    "android": {
      "package": "com.abdrhsteam.joinme"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
